{
  "name": "lumina",
  "productName": "Lumina",
  "version": "1.0.0",
  "description": "Cross-platform desktop gallery for CivitAI images with ComfyUI integration",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/lib/validate.test.mts",
    "build": "electron-forge package"
  },
  "keywords": ["civitai", "comfyui", "electron", "gallery"],
  "author": {
    "name": "Waseem Anjum",
    "email": "waseemaofficial@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fabwaseem/lumina.git"
  },
  "bugs": {
    "url": "https://github.com/fabwaseem/lumina/issues"
  },
  "homepage": "https://www.fabwaseem.com",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/publisher-github": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^5.2.0",
    "dotenv": "^17.4.2",
    "electron": "^40.10.6",
    "eslint": "^8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@virtuoso.dev/masonry": "^1.4.3",
    "electron-squirrel-startup": "^1.0.1",
    "lucide-react": "^0.563.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-virtuoso": "^4.18.19",
    "update-electron-app": "^3.3.0"
  }
}
